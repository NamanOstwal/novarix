# Novarix Backend Environment Configuration

# Optional: Instant Slack Alerts for new Enterprise Consultation requests
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Optional: Discord Webhook for lead notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Optional: Resend Email notifications (https://resend.com)
RESEND_API_KEY=re_123456789
NOTIFICATION_EMAIL=enterprise@novarix.ai

# Optional: Database connection URL (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@host:5432/novarix
