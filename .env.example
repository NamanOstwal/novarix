# ==============================================================================
# Novarix Email & Lead Notification Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Resend (Recommended - takes 30 seconds to setup at https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL=your-inbox@gmail.com
# Optional: if you have a verified domain on Resend (e.g. leads@yourcompany.com)
# RESEND_FROM_EMAIL=Novarix Leads <leads@yourdomain.com>

# ------------------------------------------------------------------------------
# OPTION 2: Standard SMTP / Gmail App Password
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password

# ------------------------------------------------------------------------------
# OPTION 3: Team Slack / Discord Alerts (Optional)
# ------------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123/XXXX
